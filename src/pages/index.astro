---
// This runs on the server
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SafePin PH</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        /* Pastel Aesthetic Overrides */
        body { margin: 0; padding: 0; font-family: sans-serif; }
        #map { height: 100vh; width: 100vw; background: #b0c4de; /* Soft pastel ocean blue */ }
        
        /* Tinting the map tiles to look more pastel and unified */
        .leaflet-tile {
            filter: sepia(20%) hue-rotate(180deg) saturate(80%) opacity(0.8);
        }

        /* Floating UI to match image_0ae941.png */
        .floating-header {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            text-align: center;
            pointer-events: none;
        }
        
        .floating-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: #fdf5e6;
            border: 2px solid #333;
            border-radius: 5px;
            width: 40px;
            height: 40px;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 2px 2px 0px rgba(0,0,0,1);
        }
    </style>
</head>
<body>

    <div class="floating-header">
        <h1 class="text-4xl font-black tracking-tighter text-gray-900 drop-shadow-md">SAFE<br>PIN PH</h1>
    </div>
    
    <button id="add-btn" class="floating-btn">+</button>

	<!-- Moderator Button -->
	<button id="mod-btn" class="absolute top-4 left-4 z-[9999] bg-white px-4 py-2 font-bold border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:bg-yellow-200 transition-colors">
		Moderators Only
	</button>

	<!-- Moderator Slide-out Panel -->
	<div id="mod-panel" class="fixed top-0 left-0 w-80 h-full bg-white border-r-4 border-black z-[10000] transform -translate-x-full transition-transform duration-300 p-4 overflow-y-auto shadow-2xl">
		<div class="flex justify-between items-center mb-6 border-b-2 border-black pb-2">
			<h2 class="font-bold text-xl">Pending Pins</h2>
			<button id="close-mod" class="font-bold text-red-500 hover:scale-110">Close X</button>
		</div>
		<div id="pending-list" class="space-y-4">
			<!-- Pending pins will load here -->
		</div>
	</div>

    <div id="map"></div>

    <!-- Add the trusted Leaflet script directly -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>

<script is:inline>
        // Initialize Map centered on the Philippines
        const map = L.map('map', { zoomControl: false }).setView([12.8797, 121.7740], 6);

        // Add minimalist light tiles
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO',
            maxZoom: 19
        }).addTo(map);

        // Add Zoom Control to bottom right
        L.control.zoom({ position: 'bottomright' }).addTo(map);

        const evacIcon = L.divIcon({
            className: 'custom-pin',
            html: `<div style="background-color: #a8e6cf; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #333; box-shadow: 2px 2px 0px #333;"></div>`,
            iconSize: [16, 16]
        });

        const medicalIcon = L.divIcon({
            className: 'custom-pin',
            html: `<div style="background-color: #ffb7b2; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #333; box-shadow: 2px 2px 0px #333;"></div>`,
            iconSize: [16, 16]
        });

        // Wrapped in a try/catch so a database error doesn't break the whole map
        async function loadPins() {
            try {
                const res = await fetch('/api/pins');
                if (!res.ok) throw new Error("Database not connected properly.");
                const pins = await res.json();
                
                pins.forEach(pin => {
                    const icon = pin.type === 'evacuation' ? evacIcon : medicalIcon;
                    const marker = L.marker([pin.latitude, pin.longitude], { icon }).addTo(map);
                    
                    marker.bindPopup(`
                        <div class="p-2">
                            <h3 class="font-bold text-lg">${pin.type.toUpperCase()}</h3>
                            <p class="text-xs text-gray-500">Submitted by ${pin.tally} user(s)</p>
                            ${pin.notes ? `<p class="mt-2">${pin.notes}</p>` : ''}
                            <hr class="my-2" />
                            <p class="text-xs font-semibold">Updated: ${new Date(pin.last_updated).toLocaleDateString()}</p>
                            <button class="text-red-500 text-xs mt-2 underline">Report Outdated</button>
                        </div>
                    `);
                });
            } catch (error) {
                console.error(error);
            }
        }

        // LEAVE THIS HERE!
        loadPins();

        // --- 1. THE DUAL-MODE SUBMISSION LOGIC ---
        let addingMode = false;
        
        // Helper function to send the data to the database
        async function submitPinToDB(lat, lng, type, notes) {
            try {
                const res = await fetch('/api/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ lat, lng, type, notes })
                });
                const result = await res.json(); 
                if (res.ok) alert("Pin submitted for moderator approval!");
                else alert("Live Server Error: " + result.error); 
            } catch(error) {
                alert("Submission completely failed.");
            }
        }

        document.getElementById('add-btn').addEventListener('click', async () => {
            // Ask the user which method they want to use
            const choice = confirm("Press 'OK' to click a location on the map, or 'Cancel' to type an address manually.");
            
            if (choice) {
                // Map Click Mode
                addingMode = true;
                document.getElementById('add-btn').style.backgroundColor = '#a8e6cf';
                document.body.style.cursor = 'crosshair';
            } else {
                // Address Search Mode
                const address = prompt("Enter the location address or landmark (e.g., 'Luneta Park, Manila'):");
                if (!address) return;

                try {
                    // Ask OpenStreetMap for the coordinates
                    const geoRes = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`);
                    const geoData = await geoRes.json();
                    
                    if (geoData.length === 0) {
                        alert("Address not found! Please try a different name or use the map click feature.");
                        return;
                    }
                    
                    const lat = parseFloat(geoData[0].lat);
                    const lng = parseFloat(geoData[0].lon);
                    
                    const type = prompt("Type? (Enter 'evacuation' or 'medical')");
                    if (!type) return;
                    const notes = prompt("Any notes? (e.g., Pet friendly, Under renovation)");
                    
                    await submitPinToDB(lat, lng, type, notes);
                } catch (err) {
                    alert("Network error while searching for address.");
                }
            }
        });

        // Handle Map Clicks
        map.on('click', async (e) => {
            if (!addingMode) return;
            const type = prompt("Type? (Enter 'evacuation' or 'medical')");
            if (!type) return;
            const notes = prompt("Any notes? (e.g., Pet friendly, Under renovation)");
            
            await submitPinToDB(e.latlng.lat, e.latlng.lng, type, notes);

            addingMode = false;
            document.getElementById('add-btn').style.backgroundColor = '#fdf5e6';
            document.body.style.cursor = '';
        });


        // --- 2. THE MODERATOR PANEL LOGIC ---
        const modPanel = document.getElementById('mod-panel');
        const pendingList = document.getElementById('pending-list');

        document.getElementById('mod-btn').addEventListener('click', async () => {
            // Presentation Theater: Add a fake password prompt to show security logic
            const pass = prompt("Enter Moderator Password:");
            if (pass !== "admin123") {
                alert("Incorrect Password!");
                return;
            }

            // Slide the panel open
            modPanel.style.transform = 'translateX(0)';
            
            // Fetch the pending pins
            pendingList.innerHTML = '<p>Loading pending pins...</p>';
            const res = await fetch('/api/pending');
            const pins = await res.json();
            
            if (pins.length === 0) {
                pendingList.innerHTML = '<p class="text-gray-500 italic">No pending pins right now.</p>';
                return;
            }

            // Generate the cards for the moderator to review
            pendingList.innerHTML = pins.map(pin => `
                <div class="border-2 border-black p-3 rounded bg-gray-50 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] mb-4" id="pin-card-${pin.id}">
                    <p class="font-bold uppercase text-sm">${pin.type}</p>
                    <p class="text-xs text-gray-600 border-b border-gray-300 pb-2 mb-2">Lat: ${pin.latitude.toFixed(4)}, Lng: ${pin.longitude.toFixed(4)}</p>
                    <p class="text-sm mb-3">Notes: ${pin.notes || 'None'}</p>
                    <button onclick="approvePin(${pin.id})" class="w-full bg-green-300 border-2 border-black py-1 font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:bg-green-400">
                        Approve Pin
                    </button>
                </div>
            `).join('');
        });

        document.getElementById('close-mod').addEventListener('click', () => {
            modPanel.style.transform = 'translateX(-100%)';
        });

        // Function attached to the Approve button inside the card
        window.approvePin = async function(id) {
            try {
                const res = await fetch('/api/approve', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });
                
                if (res.ok) {
                    // Remove the card from the sidebar
                    document.getElementById(`pin-card-${id}`).remove();
                    
                    // Reload the public map to show the newly approved pin!
                    alert("Pin approved! It is now live on the map.");
                    location.reload(); 
                }
            } catch (err) {
                alert("Approval failed.");
            }
        };
    </script>
</body>
</html>
