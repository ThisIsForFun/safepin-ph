---
// This runs on the server
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SafePin PH</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body { margin: 0; padding: 0; font-family: sans-serif; overflow: hidden; }
        #map { height: 100vh; width: 100vw; background: #b0c4de; }
        
        .leaflet-tile {
            filter: sepia(20%) hue-rotate(180deg) saturate(80%) opacity(0.8);
        }

        .floating-header {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            text-align: center;
            pointer-events: none;
        }
        
        .floating-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: #fdf5e6;
            border: 2px solid #333;
            border-radius: 5px;
            width: 40px;
            height: 40px;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 2px 2px 0px rgba(0,0,0,1);
        }

        #mod-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 1000;
            background: #fdf5e6;
            border: 2px solid #333;
            padding: 8px 16px;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            box-shadow: 2px 2px 0px rgba(0,0,0,1);
            transition: background 0.2s;
        }
        #mod-btn:hover { background: #ffb7b2; }

        #mod-panel {
            position: fixed;
            top: 0;
            left: 0;
            width: 320px;
            height: 100vh;
            background: #fdf5e6;
            border-right: 4px solid #333;
            z-index: 2000;
            transform: translateX(-100%);
            transition: transform 0.3s ease-in-out;
            padding: 20px;
            box-sizing: border-box;
            overflow-y: auto;
            box-shadow: 8px 0px 0px 0px rgba(0,0,0,0.2);
        }

        .mod-card {
            border: 3px solid #333;
            padding: 12px;
            background: white;
            box-shadow: 3px 3px 0px 0px rgba(0,0,0,1);
            margin-bottom: 16px;
        }

        .btn-approve {
            background: #a8e6cf;
            border: 2px solid #333;
            padding: 6px 12px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 2px 2px 0px 0px rgba(0,0,0,1);
            width: 48%;
        }
        .btn-approve:hover { background: #8cd9bc; }

        .btn-reject {
            background: #ffb7b2;
            border: 2px solid #333;
            padding: 6px 12px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 2px 2px 0px 0px rgba(0,0,0,1);
            width: 48%;
        }
        .btn-reject:hover { background: #ff9994; }

        /* Popup Delete Button styling */
        .btn-delete-popup {
            background: #ffb7b2;
            border: 2px solid #333;
            padding: 4px 8px;
            font-weight: bold;
            font-size: 11px;
            cursor: pointer;
            box-shadow: 2px 2px 0px 0px rgba(0,0,0,1);
            margin-top: 8px;
            width: 100%;
        }
        .btn-delete-popup:hover { background: #ff9994; }
    </style>
</head>
<body>

    <div class="floating-header">
        <h1 style="font-size: 36px; font-weight: 900; line-height: 1; letter-spacing: -0.05em; margin: 0;">SAFE<br>PIN PH</h1>
    </div>
    
    <button id="add-btn" class="floating-btn">+</button>

    <button id="mod-btn">MODERATORS ONLY</button>

    <div id="mod-panel">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #333; padding-bottom: 10px; margin-bottom: 20px;">
            <h2 style="font-weight: 900; font-size: 20px; margin: 0;">PENDING PINS</h2>
            <button id="close-mod" style="font-weight: bold; border: 2px solid #333; background: white; padding: 2px 8px; cursor: pointer; box-shadow: 2px 2px 0px 0px rgba(0,0,0,1);">X</button>
        </div>
        <div id="pending-list"></div>
    </div>

    <div id="map"></div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>

    <script is:inline>
        const map = L.map('map', { zoomControl: false }).setView([12.8797, 121.7740], 6);

        // Use a tile layer that includes labels and street names
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO',
            maxZoom: 19
        }).addTo(map);

        L.control.zoom({ position: 'bottomright' }).addTo(map);

        const evacIcon = L.divIcon({
            className: 'custom-pin',
            html: `<div style="background-color: #a8e6cf; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #333; box-shadow: 2px 2px 0px #333;"></div>`,
            iconSize: [16, 16]
        });

        const medicalIcon = L.divIcon({
            className: 'custom-pin',
            html: `<div style="background-color: #ffb7b2; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #333; box-shadow: 2px 2px 0px #333;"></div>`,
            iconSize: [16, 16]
        });

        async function loadPins() {
            try {
                const res = await fetch('/api/pins');
                if (!res.ok) throw new Error("Database error");
                const pins = await res.json();
                
                pins.forEach(pin => {
                    const icon = pin.type === 'evacuation' ? evacIcon : medicalIcon;
                    const marker = L.marker([pin.latitude, pin.longitude], { icon }).addTo(map);
                    
                    marker.bindPopup(`
                        <div style="padding: 4px; min-width: 160px;">
                            <h3 style="font-weight: bold; font-size: 15px; margin: 0 0 2px 0; text-transform: uppercase;">${pin.name || pin.type}</h3>
                            <p style="font-size: 11px; color: #555; margin: 0 0 6px 0;">Submitted by ${pin.tally} user(s)</p>
                            <p style="font-size: 12px; font-weight: 600; margin: 0 0 6px 0;">📍 ${pin.address || 'N/A'}</p>
                            ${pin.notes ? `<p style="margin: 0 0 6px 0; font-size: 12px; font-style: italic;">"${pin.notes}"</p>` : ''}
                            <hr style="margin: 6px 0; border: 0; border-top: 1px solid #ddd;" />
                            <p style="font-size: 10px; font-weight: bold; margin: 0 0 4px 0;">Updated: ${new Date(pin.last_updated).toLocaleDateString()}</p>
                            <button onclick="deletePin(${pin.id})" style="background: #ffb7b2; border: 2px solid #333; padding: 6px 12px; font-weight: bold; font-size: 11px; cursor: pointer; box-shadow: 2px 2px 0px 0px rgba(0,0,0,1); margin-top: 8px; width: 100%;">DELETE PIN</button>
                        </div>
                    `);
                });
            } catch (error) { console.error(error); }
        }

        loadPins();

        let addingMode = false;
        
        async function submitPinToDB(lat, lng, type, name, address, notes) {
            try {
                const res = await fetch('/api/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ lat, lng, type, name, address, notes })
                });
                const result = await res.json(); 
                if (res.ok) alert("Pin submitted for moderator approval!");
                else alert("Error: " + result.error); 
            } catch(error) { alert("Submission failed."); }
        }

        document.getElementById('add-btn').addEventListener('click', async () => {
            const choice = confirm("Press 'OK' to click a location on the map, or 'Cancel' to type an address manually.");
            
            const name = prompt("Enter Evacuation/Site Name (e.g., 'Alabang Barangay Hall'):");
            if (!name) return;

            const type = prompt("Type? (Enter 'evacuation' or 'medical')");
            if (!type) return;

            const notes = prompt("Any notes? (e.g., Pet friendly)");

            if (choice) {
                addingMode = true;
                window.pendingPinData = { type, name, notes };
                document.getElementById('add-btn').style.backgroundColor = '#a8e6cf';
                document.body.style.cursor = 'crosshair';
                alert("Now click the exact spot on the map!");
            } else {
                const address = prompt("Enter the street address or landmark:");
                if (!address) return;

                try {
                    const geoRes = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(address)}`);
                    const geoData = await geoRes.json();
                    if (geoData.length === 0) { alert("Address not found!"); return; }
                    
                    await submitPinToDB(parseFloat(geoData[0].lat), parseFloat(geoData[0].lon), type, name, address, notes);
                } catch (err) { alert("Network error."); }
            }
        });

        map.on('click', async (e) => {
            if (!addingMode) return;
            const data = window.pendingPinData;
            // Reverse geocode rough address for map clicks
            const address = `Lat: ${e.latlng.lat.toFixed(3)}, Lng: ${e.latlng.lng.toFixed(3)}`;
            
            await submitPinToDB(e.latlng.lat, e.latlng.lng, data.type, data.name, address, data.notes);

            addingMode = false;
            document.getElementById('add-btn').style.backgroundColor = '#fdf5e6';
            document.body.style.cursor = '';
        });

        // Moderator Panel
        const modPanel = document.getElementById('mod-panel');
        const pendingList = document.getElementById('pending-list');

        document.getElementById('mod-btn').addEventListener('click', async () => {
            const pass = prompt("Enter Moderator Password:");
            if (pass !== "admin123") { alert("Incorrect Password!"); return; }

            modPanel.style.transform = 'translateX(0)';
            pendingList.innerHTML = '<p style="font-weight: bold;">Loading...</p>';
            
            const res = await fetch('/api/pending');
            const pins = await res.json();
            
            if (pins.length === 0) {
                pendingList.innerHTML = '<p style="font-style: italic; color: #666;">No pending pins right now.</p>';
                return;
            }

            pendingList.innerHTML = pins.map(pin => `
                <div class="mod-card" id="pin-card-${pin.id}">
                    <p style="font-weight: 900; font-size: 16px; text-transform: uppercase; margin: 0 0 4px 0; border-bottom: 2px solid #333; padding-bottom: 4px;">${pin.name}</p>
                    <p style="font-size: 11px; font-weight: bold; margin: 0 0 4px 0; color: #555;">TYPE: ${pin.type.toUpperCase()}</p>
                    <p style="font-size: 12px; font-weight: bold; margin: 0 0 4px 0;">📍 ${pin.address}</p>
                    <p style="font-size: 13px; margin: 0 0 12px 0;">NOTES: ${pin.notes || 'None'}</p>
                    
                    <div style="display: flex; justify-content: space-between;">
                        <button onclick="approvePin(${pin.id})" class="btn-approve">APPROVE</button>
                        <button onclick="rejectPin(${pin.id})" class="btn-reject">REJECT</button>
                    </div>
                </div>
            `).join('');
        });

        document.getElementById('close-mod').addEventListener('click', () => {
            modPanel.style.transform = 'translateX(-100%)';
        });

        window.approvePin = async function(id) {
            const res = await fetch('/api/approve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            if (res.ok) { alert("Pin approved!"); location.reload(); }
        };

        window.rejectPin = async function(id) {
            if (!confirm("Delete submission?")) return;
            const res = await fetch('/api/reject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            if (res.ok) { document.getElementById(`pin-card-${id}`).remove(); }
        };

        window.deletePin = async function(id) {
            if (!confirm("Are you sure you want to delete this live pin from the map?")) return;
            const res = await fetch('/api/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            if (res.ok) {
                alert("Pin deleted successfully.");
                location.reload();
            } else {
                alert("Failed to delete pin.");
            }
        };
    </script>
</body>
</html>