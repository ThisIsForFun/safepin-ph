{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "compatibility_date": "2026-08-02",
    "compatibility_flags": [
        "global_fetch_strictly_public"
    ],
    "name": "safepin-ph",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "safepin-db",
            "database_id": "0e7ff596-c49c-42f5-ac3f-e13c48a45209"
        }
    ]
}